PORT=3000
NODE_ENV=development
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=erp_db
DB_NAME_TEST=erp_db_test
JWT_SECRET=supersecretjwtkey
JWT_REFRESH_SECRET=supersecretrefreshkey
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef
CORS_ORIGIN=http://localhost:3001
# Set to true in production to enable API + auth brute-force rate limiting
RATE_LIMIT_ENABLED=false
# Largest report export generated inline. Requests above this are refused with a
# "narrow your filters" message rather than blocking a worker.
REPORT_EXPORT_MAX_ROWS=50000
