# Copy to .env and fill in real values. NEVER put real credentials in this file —
# .env.example is committed to a public repository; .env is gitignored.

PORT=3000
NODE_ENV=development

# --- Database -----------------------------------------------------------
# Tests connect to the same host but to DB_NAME_TEST, which they DROP and
# rebuild from the migrations on every run. Never point DB_NAME_TEST at a
# database that holds data you care about.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=erp_db
DB_NAME_TEST=erp_db_test

# --- Auth ---------------------------------------------------------------
# Generate per environment, e.g. `openssl rand -hex 32`. Do not reuse the
# same value across environments, and do not ship these defaults.
JWT_SECRET=change-me-generate-a-random-secret
JWT_REFRESH_SECRET=change-me-generate-a-different-random-secret
# Must be exactly 32 characters — validated at boot in src/config/env.js.
ENCRYPTION_KEY=change-me-32-chars00000000000000

# --- Web ----------------------------------------------------------------
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3000
COMPANY_NAME=Infideep

# Turn on in production to enable API and auth brute-force rate limiting.
RATE_LIMIT_ENABLED=false

# Largest report export generated inline. Requests above this are refused with
# a "narrow your filters" message rather than blocking a worker.
REPORT_EXPORT_MAX_ROWS=50000

# --- Email (SMTP) -------------------------------------------------------
# Leave blank in development: the email service logs the invite/reset link to
# the console instead of sending, which is what the tests rely on.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=no-reply@example.com

# --- Firebase Storage ---------------------------------------------------
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
