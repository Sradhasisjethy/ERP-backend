# Copy to .env and fill in real values. NEVER put real credentials in this file —
# .env.example is committed to a public repository; .env is gitignored.

PORT=3000
NODE_ENV=development

# --- Database -----------------------------------------------------------
# Tests do not use DB_NAME. They connect to "<DB_NAME>_test" (unless
# DB_NAME_TEST overrides it) and rebuild its schema from the migrations on every
# run. That database must already exist — provisioning is done outside this
# repository, and the suite fails with the CREATE DATABASE to run if it is
# missing. Its schema is dropped on every run, so never let it name a database
# that holds data you care about.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=erp_db

# Optional: run migrations as a separate, more privileged role so the app's
# DB_USER needs only data rights (see docs/db-least-privilege.md). Unset, the
# migrations use DB_USER.
# DB_MIGRATOR_USER=erp_migrator
# DB_MIGRATOR_PASSWORD=

# TLS to PostgreSQL. Set DB_SSL=true whenever the database is not on the same
# host — otherwise the password and every row cross the network in plaintext.
# Certificate verification stays on; point DB_SSL_CA_FILE at the server's CA
# bundle (e.g. AWS RDS global-bundle.pem). Only for a self-signed certificate
# with no CA available, set DB_SSL_REJECT_UNAUTHORIZED=false.
DB_SSL=false
# DB_SSL_CA_FILE=/etc/ssl/certs/db-ca.pem
# DB_SSL_REJECT_UNAUTHORIZED=true

# --- Auth ---------------------------------------------------------------
# Generate per environment. Do not reuse a value across environments, and do
# not ship these defaults — src/config/env.js refuses to boot on any of them.
#
# Each secret must be at least 32 characters, must not start with a placeholder
# word, and must not be one short block repeated. The two JWT secrets must
# differ from each other: sharing one lets a refresh token pass as an access
# token. JWT_SECRET is the whole auth boundary — tenant scoping is read from
# the verified claims, so a guessable key is a cross-tenant read of everything.
#
#   JWT_SECRET / JWT_REFRESH_SECRET:  openssl rand -hex 32   (64 chars)
#   ENCRYPTION_KEY:                   openssl rand -hex 16   (exactly 32)
JWT_SECRET=change-me-generate-a-random-secret
JWT_REFRESH_SECRET=change-me-generate-a-different-random-secret
# Must be exactly 32 characters — validated at boot in src/config/env.js.
ENCRYPTION_KEY=change-me-32-chars00000000000000

# --- Web ----------------------------------------------------------------
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3000
COMPANY_NAME=Infideep

# The zone the DATABASE computes dates in — must match the tenant's Settings >
# timezone. Sequelize pins every connection's TimeZone, and with this unset it
# pins UTC regardless of how the server is configured (AWS RDS also defaults to
# UTC). CURRENT_DATE drives receivables ageing, overdue orders, days pending and
# stock ageing, so under UTC all of them read the previous day between 00:00 and
# 05:30 IST. tests/report-dates.test.js fails if this drifts.
APP_TIMEZONE=Asia/Kolkata

# API and auth brute-force rate limiting. Leave unset for the default: on when
# NODE_ENV=production, off elsewhere. Set true/false only to override that.
# RATE_LIMIT_ENABLED=true
# Production ceilings per 15 minutes: 1500 per signed-in user (keyed on the
# verified access token), 100 per IP for requests without one, 10 failed
# sign-ins per IP. Forgot-password: 3 per email per hour. /health* is never
# limited.

# Reverse-proxy hops in front of this process. Rate limiters bucket on the
# client IP, and Express only recovers it from X-Forwarded-For when this is set.
#   0  no proxy — req.ip is the socket address (safe default; headers ignored)
#   1  one nginx / ALB / Cloudflare in front — and on Render, which always has
#      its own proxy: Render deployments MUST set 1
# Behind a proxy but left at 0, every request looks like it came from the proxy:
# all traffic shares one bucket and the login limiter throttles your whole
# customer rather than the attacker. Set too high, a client can spoof the
# header and hand itself a fresh bucket — so use the real hop count.
TRUST_PROXY_HOPS=0

# Largest report export generated inline. Requests above this are refused with
# a "narrow your filters" message rather than blocking a worker.
REPORT_EXPORT_MAX_ROWS=10000

# --- Logging -------------------------------------------------------------
# Print every SQL statement (development only). Off by default: the logged SQL
# carries WHERE values — emails, Aadhaar/phone searches, reset-token hashes.
# DB_LOG_SQL=true

# --- Email (SMTP) -------------------------------------------------------
# Leave blank in development: nothing is sent. To see invite/reset links on a
# local machine, set PRINT_EMAIL_LINKS=true — they are working credentials, so
# this is never honoured in production. Tests never touch SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=no-reply@example.com

# --- Firebase Storage ---------------------------------------------------
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
